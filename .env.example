# Rename this file to .env and fill in real values. Never commit the real .env to GitHub.

BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=telegram_bot

# Public URL for the promote web panel — on Railway: Settings > Networking >
# Generate Domain, then paste that URL here (no trailing slash).
WEBAPP_URL=https://your-app-name.up.railway.app

# Railway sets this automatically — only needed for local testing.
PORT=8080

